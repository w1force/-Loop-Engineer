# 复制为 .env 并填入真实值。
# 前缀 LOOP_ENGINEER_ 刻意避开 Anthropic 官方 SDK 的 ANTHROPIC_* 变量,互不干扰。
LOOP_ENGINEER_API_KEY=sk-ant-xxx
LOOP_ENGINEER_BASE_URL=https://api.anthropic.com
LOOP_ENGINEER_MODEL=claude-sonnet-4-6
LOOP_ENGINEER_MAX_TOKENS=4096
LOOP_ENGINEER_MAX_TURNS=20
LOOP_ENGINEER_DEBUG_SSE=True

# MCP 配置文件入口。文件形状对齐 Claude Code 的 .mcp.json:
# {"mcpServers":{"server-name":{"type":"stdio","command":"...","args":["..."]}}}
LOOP_ENGINEER_MCP_CONFIG=[]
LOOP_ENGINEER_MCP_CONFIG_PATH=
LOOP_ENGINEER_MCP_TOOL_WAIT_TIMEOUT=5
LOOP_ENGINEER_MCP_TOOL_TIMEOUT_SECONDS=100000
LOOP_ENGINEER_MCP_TOOL_HEARTBEAT_SECONDS=30
# JProfiler 官方 MCP:
#   简单上手: cp .mcp.jprofiler.example.json .mcp.json
#   已安装 JProfiler: cp .mcp.jprofiler.local.example.json .mcp.json,
#     再把 /path/to/JProfiler/bin/jpmcp 改成自己的本机路径。
# 然后设置 LOOP_ENGINEER_MCP_CONFIG_PATH=.mcp.json。不要提交个人 .mcp.json。

# TDA 快捷入口。长期更推荐写进 MCP 配置文件;这里保留给本地快速验证。
LOOP_ENGINEER_TDA_ENABLED=false
LOOP_ENGINEER_TDA_JAR_PATH=
LOOP_ENGINEER_TDA_TIMEOUT=60
LOOP_ENGINEER_TDA_TOOL_WAIT_TIMEOUT=5
