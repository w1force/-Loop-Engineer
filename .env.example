# 复制为 .env 并填入真实值。
# 前缀 LOOP_ENGINEER_ 刻意避开 Anthropic 官方 SDK 的 ANTHROPIC_* 变量,互不干扰。
LOOP_ENGINEER_API_KEY=sk-ant-xxx
LOOP_ENGINEER_BASE_URL=https://api.anthropic.com
LOOP_ENGINEER_MODEL=claude-sonnet-4-6
LOOP_ENGINEER_MAX_TOKENS=4096
# 可选：显式请求 provider-visible reasoning；0 为关闭，非 0 必须 >=1024 且小于 MAX_TOKENS。
LOOP_ENGINEER_THINKING_BUDGET_TOKENS=1024
LOOP_ENGINEER_MAX_TURNS=20
LOOP_ENGINEER_DEBUG_SSE=True
LOOP_ENGINEER_VERIFICATION_AGENT_ENABLED=True
LOOP_ENGINEER_VERIFICATION_AGENT_MAX_TURNS=10
# Repair Skill 学习归档与动态 catalog（均为本地路径，可按部署覆盖）
LOOP_ENGINEER_LEARNING_ARCHIVE_ROOT=~/.loop-engineer/repair-learning
LOOP_ENGINEER_LEARNED_SKILLS_ROOT=~/.loop-engineer/learned-repair-skills
# 默认继承 LOOP_ENGINEER_MODEL；仅在同一 provider 端点支持时覆盖。
# LOOP_ENGINEER_LEARNING_SUMMARIZATION_MODEL=claude-haiku-4-5
# LOOP_ENGINEER_LEARNING_DISTILLATION_MODEL=claude-haiku-4-5
# GitHub 人工审批轮询使用 GITHUB_TOKEN；不要把真实 token 写入此文件。
